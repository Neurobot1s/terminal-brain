{
  // NeuroBot is a pure vanilla JS/CSS/HTML app — there is intentionally no
  // TypeScript app source. This config exists only so the platform's generic
  // `tsc -b --noEmit` check has a valid tsconfig to run against. It typechecks
  // the template's integration helper and is NOT part of the deployed site
  // (skip on htdocs).
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
