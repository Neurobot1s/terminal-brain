# NeuroBot — InfinityFree helpers
DirectoryIndex index.html index.php

# Never cache the AI proxy (responses must always be fresh)
<IfModule mod_headers.c>
  <FilesMatch "ai\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Reasonable caching for static assets
  <FilesMatch "\.(css|js|svg)$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Stop listings of folders
Options -Indexes
